generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Role {
  USER
  ADMIN
  PARTNER
}

enum VehicleType {
  BIKE
  CAR
  AUTO
  LOADING
  TRUCK
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BankStatus {
  NOT_ADDED
  ADDED
  VERIFIED
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VideoKycStatus {
  NOT_REQUIRED
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum BookingStatus {
  IDLE
  REQUESTED
  AWAITING_PAYMENT
  CONFIRMED
  STARTED
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  CASH
  FAILED
}

// --- MODELS ---

model User {
  id                     String             @id @default(cuid())
  name                   String
  email                  String             @unique
  password               String?
  phone                  String?
  role                   Role               @default(USER)
  isVerified             Boolean            @default(false)
  verifyOtp              String?
  otpExpiry              DateTime?
  partnerOnboardingSteps Int                @default(0)
  partnerStatus          PartnerStatus      @default(PENDING)
  rejectReason           String?
  videoKycStatus         VideoKycStatus     @default(NOT_REQUIRED)
  videoKycRoomId         String?            @unique
  videoKycRejectReason   String?
  socketId               String?            @unique
  isOnline               Boolean            @default(false)
  location               Json?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt
  vehicles               Vehicle[]
  documents              PartnerDocument?
  bankDetails            PartnerBankDetail?
  userBookings           Booking[]          @relation("UserBookings")
  partnerBookings        Booking[]          @relation("PartnerBookings")
  sentMessages           Message[]          @relation("SentMessages")
  receivedMessages       Message[]          @relation("ReceivedMessages")

  @@map("users")
}

model Vehicle {
  id            String             @id @default(cuid())
  ownerId       String
  owner         User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type          VehicleType
  model         String
  vehicleNumber String             @unique
  frontImageUrl String?
  backImageUrl  String?
  leftImageUrl  String?
  rightImageUrl String?
  baseFare      Float?
  pricePerKm    Float?
  waitingCharge Float?
  status        VerificationStatus @default(PENDING)
  rejectReason  String?
  isActive      Boolean            @default(false)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  bookings      Booking[]

  @@map("vehicles")
}

model PartnerDocument {
  id                String             @id @default(cuid())
  ownerId           String             @unique
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  aadharCardUrl     String
  rcUrl             String
  drivingLicenseUrl String
  status            VerificationStatus @default(PENDING)
  rejectReason      String?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  @@map("partner_documents")
}

model PartnerBankDetail {
  id                String     @id @default(cuid())
  ownerId           String     @unique
  owner             User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  accountHolderName String
  accountNumber     String     @unique
  ifscCode          String
  upiId             String?
  status            BankStatus @default(NOT_ADDED)
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  @@map("partner_bank_details")
}

model Booking {
  id                  String        @id @default(cuid())
  userId              String
  partnerId           String
  vehicleId           String
  user                User          @relation("UserBookings", fields: [userId], references: [id])
  partner             User          @relation("PartnerBookings", fields: [partnerId], references: [id])
  vehicle             Vehicle       @relation(fields: [vehicleId], references: [id])
  pickUpAddress       String
  dropAddress         String
  pickUpLocation      Json
  dropLocation        Json
  fare                Float
  adminComission      Float         @default(0.0)
  partnerAmount       Float         @default(0.0)
  userMobileNumber    String
  partnerMobileNumber String
  bookingStatus       BookingStatus @default(IDLE)
  paymentStatus       PaymentStatus @default(PENDING)
  paymentDeadline     DateTime?
  pickUpOtp           String?
  pickupOtpExpire     DateTime?
  dropOtp             String?
  dropOtpExpire       DateTime?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  messages            Message[]

  @@index([userId])
  @@index([partnerId])
  @@index([bookingStatus])
  @@map("bookings")
}

model Message {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String   @db.Text
  isRead     Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([bookingId])
  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}
